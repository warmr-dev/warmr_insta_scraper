# Copy to .env and fill in. NEVER commit .env.

# --- Transport -------------------------------------------------------------
# fixture = replay recorded JSON from ./fixtures/ (no real Instagram calls)
# live    = real instagrapi calls
IG_TRANSPORT=fixture

# Пауза сбора без снятия деплоя: контейнер стартует, пишет одну строку в лог и
# выходит, не сделав ни одного запроса к Instagram. Действует и на run_loop.py,
# и на run_once.py.
#
# Зачем: когда Instagram троттлит IP (401 на feed/reels_media), продолжать
# ходить каждые полторы минуты бессмысленно - лимит от этого только держится
# дольше. Дашборд при этом остаётся живым, он читает ту же базу.
#
# Это ОТДЕЛЬНЫЙ флаг, а не значение IG_TRANSPORT: тот отвечает на вопрос
# "каким транспортом ходить", и гейт Slack завязан на него - смешав их, мы бы
# заодно увели лиды в stdout.
SCRAPER_OFFLINE=false

# --- нагрузка на Instagram ---------------------------------------------------
# Потолок обращений на аккаунт в сутки. Аккаунт, упёршийся в него, отдыхает до
# следующих суток. Предупреждение об автоматизации прилетает не за один запрос,
# а за сотни подряд по одной сессии.
DAILY_REQUEST_BUDGET=400

# Тихие часы (UTC), когда цели почти не публикуют: замерено за 30 дней,
# 04:00-17:00 дают втрое больше сторис, чем 18:00-03:00. Ночью опрашиваем
# каждый QUIET_HOURS_SKIP-й аккаунт за цикл, а не всех.
QUIET_HOURS_START=18
QUIET_HOURS_END=4
QUIET_HOURS_SKIP=3

# Отдых после 401/429, удваивается при повторах, сбрасывается после успеха.
REST_BASE_SEC=600
REST_MAX_SEC=21600

# --- Secrets ---------------------------------------------------------------
# Fernet key used to encrypt worker_accounts.password_enc at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=REPLACE_WITH_FERNET_KEY

# --- Database --------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI.
# ВАЖНО: префикс postgresql+psycopg:// обязателен для SQLAlchemy,
# а Supabase показывает просто postgresql:// - его нужно заменить.
DATABASE_URL=postgresql+psycopg://postgres.XXX:ПАРОЛЬ@aws-0-РЕГИОН.pooler.supabase.com:5432/postgres
# Локальная база для офлайн-разработки:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/stories_monitor

# --- Redis -----------------------------------------------------------------
# Redis НЕ нужен для веб-пути: run_loop.py работает последовательно.
# Он нужен только распределённому мобильному пути (ТЗ §6), когда семь
# процессов в разных контейнерах должны видеть общую очередь.
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# --- Poller ----------------------------------------------------------------
POLL_INTERVAL_SEC=120
POLL_JITTER_MAX_SEC=30
# Turn on if probe_tray.py proves the tray is truncated (see SPEC 7.2)
TRAY_PAGINATION_ENABLED=false
TRAY_PAGE_SIZE=50

# --- Fetcher ---------------------------------------------------------------
FETCH_BATCH_SIZE=50
FETCH_BATCH_TIMEOUT_SEC=5

# --- AI --------------------------------------------------------------------
# The pipeline is provider-agnostic behind the AIClient
# protocol, so switching is a config change, not a rewrite. Set the matching
# key and the matching model ids below.
AI_PROVIDER=anthropic   # anthropic | gemini | openrouter
ANTHROPIC_API_KEY=REPLACE_ME
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# For AI_PROVIDER=anthropic:
CHEAP_MODEL=claude-haiku-4-5-20251001
SMART_MODEL=claude-sonnet-5
# For AI_PROVIDER=openrouter - model ids MUST carry the provider prefix,
# a bare name returns 404:
#   CHEAP_MODEL=google/gemini-2.5-flash-lite
#   SMART_MODEL=google/gemini-2.5-flash
# For AI_PROVIDER=gemini, use the stable aliases - the dated 2.5/2.0 model ids
# are retired for new keys and return 404:
#   CHEAP_MODEL=gemini-flash-lite-latest
#   SMART_MODEL=gemini-pro-latest

# tesseract (local binary) or vision (uses the cheap model). SPEC 7.4 says
# measure both during the pilot and keep the cheaper one.
OCR_ENGINE=tesseract
SMART_MODEL_SCORE_MIN=5
SMART_MODEL_SCORE_MAX=6

# --- Business checks -------------------------------------------------------
# SPEC open question #4: "roughly 70-75" - confirm with project owner
SERVICE_FIT_THRESHOLD=70
APPROVAL_SCORE_MIN=7

# --- Приоритизация целей (ТЗ §5) ---
# Цели, стабильно не дающие лидов, пропускаются до плановой перепроверки.
PRIORITY_ENABLED=true
PRIORITY_MIN_SAMPLES=8
PRIORITY_RECHECK_HOURS=24

# --- Telegram (алерты о простое) ---
# Лиды идут в Slack, а сюда - сообщения "система встала". Главный случай:
# веб-куки истекли, продлить их из кода нельзя, нужен человек с браузером.
# Бот: @BotFather -> /newbot. chat_id: напишите боту и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_SEC=3600

# --- Slack -----------------------------------------------------------------
# In fixture mode Slack writes to stdout regardless of these values.
SLACK_BOT_TOKEN=REPLACE_ME
SLACK_CHANNEL=#leads

# --- Follower --------------------------------------------------------------
FOLLOWS_PER_DAY=150
FOLLOW_GAP_MIN_SEC=240
FOLLOW_GAP_MAX_SEC=720
FOLLOW_WINDOW_START_HOUR=9
FOLLOW_WINDOW_END_HOUR=23

# --- Warden ----------------------------------------------------------------
MIN_ACTIVE_WORKERS_PER_SHARD=2
POLLER_LAG_ALERT_SEC=300
MONTHLY_BUDGET_USD=650
