# Local secrets. NEVER commit this file (.gitignore covers it).

# --- Transport -------------------------------------------------------------
# Stays 'fixture' until a proxy is bound to the worker account below.
# Flip to 'live' ONLY when IG_WORKER_PROXY_URL is set (SPEC section 8).
IG_TRANSPORT=live

# --- Secrets ---------------------------------------------------------------
SECRET_KEY=hFI-gdoATKyRad3ozn8ECE0PFA6L-dPmKMP5HXALhRY=

# --- Database --------------------------------------------------------------
DATABASE_URL=

# --- Redis -----------------------------------------------------------------
REDIS_URL=

# --- Probe / first worker account ------------------------------------------
# Used by scripts/probe_tray.py --from-env to answer SPEC open question #1
# (does reels_tray truncate?). Password is stored encrypted at rest once the
# account is seeded into worker_accounts; this env value is the seed source.
IG_WORKER_USERNAME=REDACTED_IG_USERNAME
IG_WORKER_PASSWORD=REDACTED_IG_PASSWORD
# REQUIRED before IG_TRANSPORT=fixture. Bound permanently, never rotated.
# Deliberately EMPTY: using the home IP. The LA datacenter proxy caused 467
# on every private-API call; the same session worked direct. Bind a US
# residential proxy here before scaling past this machine (SPEC section 8).
IG_WORKER_PROXY_URL=

# --- AI --------------------------------------------------------------------
# TEMPORARY: using Gemini because only a Gemini key is available.
# Switch back with AI_PROVIDER=anthropic + ANTHROPIC_API_KEY (models below too).
AI_PROVIDER=openrouter
GEMINI_API_KEY=
OPENROUTER_API_KEY=sk-or-v1-REDACTED
ANTHROPIC_API_KEY=
# Stable aliases: the dated 2.5/2.0 ids are retired for new keys and 404.
CHEAP_MODEL=google/gemini-2.5-flash-lite
SMART_MODEL=google/gemini-2.5-flash
# tesseract is not installed locally; 'vision' uses the cheap model instead.
OCR_ENGINE=vision

# --- Slack -----------------------------------------------------------------
