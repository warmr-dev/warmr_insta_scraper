# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime state - sessions and downloaded media must never be committed.
# Anchored with a leading slash: a bare `sessions/` also matched
# web/app/api/sessions/, so that API route was silently never committed and
# returned 404 in production.
/sessions/
/tmp_media/
/probe_output/
*.log

# Pilot / scrape outputs
hiker_stories_pilot_*.jsonl
*.jsonl

# IDE / OS
.cursor/
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Browser cookies - never commit
cookies.txt
cookies*.txt
cookies/
*_cookies.json

# Скачанные сторис для ручной проверки - медиа не хранится (ТЗ §10)
downloaded_stories/

# Target lists. These hold tens of thousands of real people's names, handles
# and profile URLs; the database is where that belongs, not the repo history -
# which is public-adjacent and, unlike a table, cannot be selectively deleted.
*.xlsx
*.xlsm
estimation/*.csv

# Saved Instagram pages. A logged-in snapshot embeds fb_dtsg/lsd tokens and the
# viewer's own account data - never commit one.
Instagram.html
*.instagram.html
Instagram*.html
Instagram*_files/
